# ==============================================================================
# Adaptive Cost-Aware Semantic Routing Gateway - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Frontend URL (For Backend CORS configuration)
FRONTEND_URL=https://adaptive-llm-routing.vercel.app

# Backend API URL (For Frontend requests)
NEXT_PUBLIC_API_URL=https://adaptive-llm-routing.onrender.com

# ------------------------------------------------------------------------------
# Supabase Database Configuration
# Project: https://tibnobwsfhrdpdbqdpux.supabase.co
# ------------------------------------------------------------------------------
SUPABASE_URL=https://tibnobwsfhrdpdbqdpux.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# Provider API Keys (Optional - System defaults to Simulation Mode)
# Leave blank to run purely in simulation mode without real API costs.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# Simulation & Routing Defaults
# ------------------------------------------------------------------------------
SIMULATION_MODE=true
DEFAULT_OBJECTIVE=balanced
LOG_ROUTING_REQUESTS=true
